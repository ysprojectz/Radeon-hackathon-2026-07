# Copy to .env in this same folder, then: docker compose -f docker-compose.yml up --build
# All values have safe demo defaults in docker-compose.yml — only override what you need.

POSTGRES_PASSWORD=claims_os_demo_only

# Agent B — must point at vLLM running on the Radeon host (see docker-compose.yml header)
LOCAL_LLM_BASE_URL=http://host.docker.internal:8000/v1
LOCAL_LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ

# Agent C — second, independent local model/server. Leave disabled until the
# second vLLM instance (port 8001, Qwen2.5-7B-Instruct-AWQ) is actually running.
LOCAL_LLM_SECONDARY_ENABLED=false
LOCAL_LLM_SECONDARY_BASE_URL=http://host.docker.internal:8001/v1
LOCAL_LLM_SECONDARY_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# Secure default — never commit this as true. Only set true temporarily and
# locally if you need to reach Admin/Senior-Adjuster-only screens without 2FA.
DISABLE_MFA=false
