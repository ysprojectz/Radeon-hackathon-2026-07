FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY services/india_cashless/bpmn_worker.py services/india_cashless/bpmn_worker.py
COPY services/india_cashless/bpmn services/india_cashless/bpmn

ENV PYTHONPATH=/app

CMD ["python", "services/india_cashless/bpmn_worker.py"]
